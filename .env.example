# OUC Underwater DeepLens Configuration
# Copy this file to .env and adjust the variables

# Environment (local, colab, or production)
ENVIRONMENT=local

# API Settings
HOST=0.0.0.0
PORT=8000

# Model Paths
MODEL_WEIGHTS_PATH=weights/unet_v3_gan_12k.pth
ONNX_WEIGHTS_PATH=weights/generator.onnx

# Data Paths
RAW_DATA_PATH=dataset/raw
REF_DATA_PATH=dataset/ref

# Training Hyperparameters
BATCH_SIZE=8
LEARNING_RATE=0.0001
EPOCHS=200
VAL_SPLIT=0.1
